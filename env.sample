# TradingAgents API Keys Configuration
# ===============================
# INSTRUCTIONS:
# 1. Copy this file and rename it to ".env" (without quotes)
# 2. Replace the placeholder values with your actual API keys
# 3. Restart the application

# Alpaca API Keys - Required for real stock data
# Get your keys from https://app.alpaca.markets/signup
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
# Set to True for paper trading, False for live trading
ALPACA_USE_PAPER=True

# OpenAI API Key - Required for LLM functionality (if using OpenAI)
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek API Key - Optional (if using DeepSeek LLM)
# Get your key from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Anthropic API Key - Optional (if using Claude/Anthropic LLM)
# Get your key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenRouter API Key - Optional (if using OpenRouter - unified access to 100+ models)
# Get your key from https://openrouter.ai/keys
# OpenRouter provides access to OpenAI, Anthropic, Google, Mistral, DeepSeek, etc.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Finnhub API Key - Required for financial news and data
# Get your key from https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# FRED API Key - Required for macro economic analysis
# Get your free key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# CryptoCompare API Key - Required for cryptocurrency news
# Get your key from https://www.cryptocompare.com/cryptopian/api-keys
COINDESK_API_KEY=your_cryptocompare_api_key_here

# Twitter API Keys - Optional for enhanced social sentiment analysis
# Get from Twitter Developer Portal: https://developer.x.com/
# ============================================

# Twitter Bearer Token - Used for reading public tweets and sentiment analysis
# OAuth 2.0 authentication - allows API access for public data without user context
# The system can fallback to web scraping if not provided
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Twitter Consumer Keys - Optional (for OAuth 1.0a and app-level actions)
# These identify your app and are used for OAuth 1.0a authentication
# Needed for: Posting tweets, OAuth flow initiation, app-level actions
# TWITTER_API_KEY=your_twitter_api_key_here
# TWITTER_API_SECRET=your_twitter_api_secret_here

# Twitter Access Tokens - Optional (for actions on behalf of a specific user account)
# These allow actions on behalf of a specific user account
# Needed for: Posting tweets as user, reading DMs, user-specific actions
# TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
# TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here